<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المستخدمين - لوحة التحكم</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" style="width: 280px; min-height: 100vh;">
            <a href="/admin/dashboard" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                <span class="fs-4">لوحة تحكم المشرف</span>
            </a>
            <hr>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a href="/admin/users" class="nav-link active" aria-current="page">
                        <i class="fas fa-users me-2"></i> إدارة المستخدمين
                    </a>
                </li>
                <li>
                    <a href="/admin/orders" class="nav-link text-white">
                        <i class="fas fa-list-check me-2"></i> إدارة الطلبات
                    </a>
                </li>
                <li>
                    <a href="/admin/funds" class="nav-link text-white">
                        <i class="fas fa-hand-holding-usd me-2"></i> طلبات شحن الرصيد
                    </a>
                </li>
            </ul>
            <hr>
            <a href="/auth/logout" class="nav-link text-white"><i class="fas fa-sign-out-alt me-2"></i> تسجيل الخروج</a>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 p-4 bg-light">
            <h1 class="mb-4">إدارة المستخدمين</h1>
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>الصورة</th>
                                    <th>الاسم</th>
                                    <th>البريد الإلكتروني</th>
                                    <th>الرصيد</th>
                                    <th>تاريخ التسجيل</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach(user => { %>
                                    <tr>
                                        <td><img src="/images/<%= user.profileImage %>" alt="صورة شخصية" width="40" height="40" class="rounded-circle"></td>
                                        <td><%= user.name %></td>
                                        <td><%= user.email %></td>
                                        <td>$<%= user.balance.toFixed(2) %></td>
                                        <td><%= new Date(user.createdAt).toLocaleDateString('ar-EG') %></td>
                                        <td>
                                            <button class="btn btn-sm btn-primary"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
