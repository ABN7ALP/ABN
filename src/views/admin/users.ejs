<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المستخدمين - لوحة التحكم</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" style="width: 280px; min-height: 100vh;">
            <a href="/admin/dashboard" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none"><span class="fs-4">لوحة تحكم المشرف</span></a><hr>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item"><a href="/admin/users" class="nav-link active" aria-current="page"><i class="fas fa-users me-2"></i> إدارة المستخدمين</a></li>
                <li><a href="/admin/orders" class="nav-link text-white"><i class="fas fa-list-check me-2"></i> إدارة الطلبات</a></li>
                <li><a href="/admin/funds" class="nav-link text-white"><i class="fas fa-hand-holding-usd me-2"></i> طلبات شحن الرصيد</a></li>
            </ul><hr>
            <a href="/auth/logout" class="nav-link text-white"><i class="fas fa-sign-out-alt me-2"></i> تسجيل الخروج</a>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 p-4 bg-light">
            <h1 class="mb-4">إدارة المستخدمين</h1>
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>الاسم</th>
                                    <th>البريد الإلكتروني</th>
                                    <th>الرصيد الحالي</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach(user => { %>
                                    <tr>
                                        <td><%= user.name %></td>
                                        <td><%= user.email %></td>
                                        <td>$<%= (user.balance || 0).toFixed(2) %></td>
                                        <td>
                                            <button class="btn btn-sm btn-primary edit-balance-btn" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#editBalanceModal"
                                                    data-user-id="<%= user._id %>"
                                                    data-user-name="<%= user.name %>"
                                                    data-current-balance="<%= (user.balance || 0).toFixed(2) %>">
                                                <i class="fas fa-edit me-1"></i> تعديل الرصيد
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Balance Modal -->
    <div class="modal fade" id="editBalanceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">تعديل رصيد المستخدم</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="editBalanceForm" method="POST">
                    <div class="modal-body">
                        <p>المستخدم: <strong id="modalUserName"></strong></p>
                        <p>الرصيد الحالي: <strong id="modalCurrentBalance"></strong></p>
                        <hr>
                        <div class="mb-3">
                            <label for="amount" class="form-label">المبلغ المراد إضافته (سالب للخصم):</label>
                            <input type="number" step="0.01" class="form-control" id="amount" name="amount" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">حفظ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const editBalanceModal = document.getElementById('editBalanceModal');
        editBalanceModal.addEventListener('show.bs.modal', (event) => {
            const button = event.relatedTarget;
            const userId = button.getAttribute('data-user-id');
            const userName = button.getAttribute('data-user-name');
            const currentBalance = button.getAttribute('data-current-balance');
            const form = editBalanceModal.querySelector('#editBalanceForm');
            editBalanceModal.querySelector('#modalUserName').textContent = userName;
            editBalanceModal.querySelector('#modalCurrentBalance').textContent = `$${currentBalance}`;
            form.action = `/admin/users/update-balance/${userId}`;
        });
    </script>
</body>
</html>
