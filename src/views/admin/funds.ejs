<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>طلبات شحن الرصيد - لوحة التحكم</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" style="width: 280px; min-height: 100vh;">
            <a href="/admin/dashboard" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none"><span class="fs-4">لوحة تحكم المشرف</span></a><hr>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item"><a href="/admin/users" class="nav-link text-white"><i class="fas fa-users me-2"></i> إدارة المستخدمين</a></li>
                <li><a href="/admin/orders" class="nav-link text-white"><i class="fas fa-list-check me-2"></i> إدارة الطلبات</a></li>
                <li><a href="/admin/funds" class="nav-link active" aria-current="page"><i class="fas fa-hand-holding-usd me-2"></i> طلبات شحن الرصيد</a></li>
            </ul><hr>
            <a href="/auth/logout" class="nav-link text-white"><i class="fas fa-sign-out-alt me-2"></i> تسجيل الخروج</a>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 p-4 bg-light">
            <h1 class="mb-4">طلبات شحن الرصيد</h1>
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover text-center">
                            <thead class="table-dark">
                                <tr>
                                    <th>المستخدم</th>
                                    <th>المبلغ</th>
                                    <th>الطريقة</th>
                                    <th>التفاصيل</th>
                                    <th>التاريخ</th>
                                    <th>الحالة</th>
                                    <th>إجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (requests.length > 0) { %>
                                    <% requests.forEach(request => { %>
                                        <tr class="align-middle">
                                            <td><%= request.user ? request.user.name : 'مستخدم محذوف' %></td>
                                            <td>$<%= request.amount.toFixed(2) %></td>
                                            <td><%= request.method %></td>
                                            <td><%= request.details %></td>
                                            <td><%= new Date(request.createdAt).toLocaleString('ar-EG') %></td>
                                            <td>
                                                <span class="badge 
                                                    <%= request.status === 'Approved' ? 'bg-success' : (request.status === 'Rejected' ? 'bg-danger' : 'bg-warning text-dark') %>">
                                                    <%= request.status === 'Pending' ? 'قيد المراجعة' : (request.status === 'Approved' ? 'مقبول' : 'مرفوض') %>
                                                </span>
                                            </td>
                                            <td>
                                                <% if (request.status === 'Pending') { %>
                                                    <form action="/admin/funds/update-status/<%= request._id %>" method="POST" class="d-inline">
                                                        <button type="submit" name="status" value="Approved" class="btn btn-sm btn-success">قبول</button>
                                                    </form>
                                                    <form action="/admin/funds/update-status/<%= request._id %>" method="POST" class="d-inline">
                                                        <button type="submit" name="status" value="Rejected" class="btn btn-sm btn-danger">رفض</button>
                                                    </form>
                                                <% } else { %>
                                                    تمت المعالجة
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-4">لا يوجد طلبات شحن رصيد حالياً.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
