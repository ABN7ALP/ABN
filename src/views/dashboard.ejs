<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة التحكم - SMM Engine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">إنشاء طلب جديد</h4>
            </div>
            <div class="card-body">
                <form id="create-order-form">
                    <div class="mb-3">
                        <label for="platform-select" class="form-label">اختر المنصة:</label>
                        <select class="form-select" id="platform-select">
                            <option selected disabled>-- اختر منصة --</option>
                            <% platforms.forEach(platform => { %>
                                <option value="<%= platform %>"><%= platform %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="service-select" class="form-label">اختر الخدمة:</label>
                        <select class="form-select" id="service-select" name="serviceId" required disabled>
                            <option selected disabled>-- اختر خدمة --</option>
                        </select>
                    </div>
                    
                    <div id="service-details" class="alert alert-info d-none"></div>

                    <div class="mb-3">
                        <label for="link" class="form-label">الرابط:</label>
                        <input type="url" class="form-control" id="link" name="link" placeholder="https://www.instagram.com/p/..." required>
                    </div>

                    <div class="mb-3">
                        <label for="quantity" class="form-label">الكمية:</label>
                        <input type="number" class="form-control" id="quantity" name="quantity" required>
                        <div class="form-text">
                            الحد الأدنى: <span id="min-order">0</span> | الحد الأقصى: <span id="max-order">0</span>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        التكلفة الإجمالية: <strong id="charge">$0.00</strong>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">تأكيد الطلب</button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        const servicesData = <%- JSON.stringify(services) %>;
    </script>
    <script src="/js/main.js"></script>
</body>
</html>
