<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الإشعارات - SMM Engine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .notification-item {
            border-right: 4px solid #dee2e6; /* رمادي للإشعار المقروء */
            transition: background-color 0.3s;
        }
        .notification-item.unread {
            border-right-color: #0d6efd; /* أزرق للإشعار غير المقروء */
            background-color: #f8f9fa;
        }
        .notification-item:hover {
            background-color: #e9ecef;
        }
        .notification-time {
            font-size: 0.8rem;
            color: #6c757d;
        }
    </style>
</head>
<body class="bg-light">

    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">الإشعارات</h1>
            <form action="/notifications/mark-all-read" method="POST">
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-check-double me-1"></i> تعليم الكل كمقروء
                </button>
            </form>
        </div>

        <div class="card">
            <div class="list-group list-group-flush">
                <% if (notifications.length > 0) { %>
                    <% notifications.forEach(notif => { %>
                        <a href="<%= notif.link %>" class="list-group-item list-group-item-action notification-item <%= !notif.isRead ? 'unread' : '' %>">
                            <div class="d-flex w-100 justify-content-between">
                                <p class="mb-1"><%= notif.message %></p>
                                <small class="notification-time"><%= new Date(notif.createdAt).toLocaleString('ar-EG') %></small>
                            </div>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div class="list-group-item text-center p-4">
                        <p class="text-muted mb-0">لا توجد إشعارات لعرضها.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
